          "name": "Veeva Authenticate and Obtain Session ID",
          "request": {
            "name": "Veeva Authenticate and Obtain Session ID",
            "description": {
              "content": "Authenticates a user with username and password and returns a session ID for use in subsequent API requests. Session IDs are included in the Authorization header for all API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Vault domain (e.g., myvault.veevavault.com)",
                  "type": "any",
                  "value": "{{vaultDomain}}",
                  "key": "vaultDomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) Vault username (email address)"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "vaultDNS",
                  "value": "<string>",
                  "description": "Target Vault DNS (for multi-vault environments)"
                }
              ]
            }
          },
